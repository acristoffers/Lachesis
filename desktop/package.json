{
  "name": "@lachesis/desktop",
  "version": "1.3.13",
  "description": "Moirai supervisor",
  "license": "MIT",
  "author": {
    "name": "Álan Crístoffer",
    "email": "acristoffers@gmail.com",
    "url": "https://github.com/acristoffers/Lachesis"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/acristoffers/Lachesis.git"
  },
  "devDependencies": {
    "@lachesis/angular-app": "*",
    "@lachesis/electron-main": "*",
    "electron": "34.3.0",
    "electron-builder": "~25.1.8"
  },
  "homepage": "https://github.com/acristoffers/Lachesis",
  "productName": "lachesis",
  "build": {
    "electronVersion": "34.3.0",
    "directories": {
      "app": "www",
      "buildResources": "build"
    },
    "extraResources": [
      {
        "from": "www/node_modules",
        "to": "node_modules"
      }
    ],
    "appId": "me.acristoffers.lachesis",
    "productName": "Lachesis",
    "asar": true,
    "copyright": "Copyright © 2017 Álan Crístoffer",
    "protocols": [
      {
        "name": "Moirai supervisor",
        "role": "Editor",
        "schemes": ["http"]
      }
    ],
    "linux": {
      "category": "Engineering",
      "packageCategory": "productivity",
      "target": ["AppImage"],
      "publish": ["github"]
    },
    "mac": {
      "category": "public.app-category.productivity",
      "type": "distribution",
      "publish": ["github"]
    },
    "win": {
      "target": ["nsis"],
      "publish": ["github"]
    },
    "nsis": {},
    "snap": {
      "environment": {
        "DISABLE_WAYLAND": 1
      }
    }
  },
  "scripts": {
    "build": "node stage.js",
    "dist": "node dist.js",
    "dist:pack": "npx electron-builder --dir",
    "release": "node release.js",
    "clean": "node -e \"['www','dist','build'].forEach(d => require('fs').rmSync(d, {recursive:true,force:true}))\""
  }
}
